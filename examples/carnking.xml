    </table>
    <table id="ARCADIA - SHOOTING GALLERY" lines-max="3">
      <column id="RANK" src="index" format="rank"/>
      <column id="SCORE" src="ASHOOT_SCORE" format="comma_score"/>
      <column id="NAME" src="ASHOOT_NAME"/>
    </table>
    <table id="ARCADIA - CLUSTER BUSTER" lines-max="3">
      <column id="RANK" src="index" format="rank"/>
