      <column id="RANK" src="index" format="rank"/>
      <column id="SCORE" src="ARCADIA_SCORE" format="comma_score"/>
      <column id="NAME" src="ARCADIA_NAME"/>
    </table>
    <table id="DREAMLAND HIGH SCORES" lines-max="11">
      <column id="RANK" src="index" format="rank"/>
      <column id="SCORE" src="DREAMLAND_SCORE" format="comma_score"/>
      <column id="NAME" src="DREAMLAND_NAME"/>
    </table>
    <table id="LAGOON PARK HIGH SCORES" lines-max="11">
      <column id="RANK" src="index" format="rank"/>
      <column id="SCORE" src="LAGOON_SCORE" format="comma_score"/>
      <column id="NAME" src="LAGOON_NAME"/>
    </table>
    <table id="ARCADIA - KNOCK 'EM OVER" lines-max="3">
      <column id="RANK" src="index" format="rank"/>
      <column id="SCORE" src="AKNOCK_SCORE" format="comma_score"/>
